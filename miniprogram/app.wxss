/* =========================================================
 * 全局设计系统：品牌渐变 + 大圆角卡片 + 柔和投影 + 胶囊标签
 * 与网页端 frontend/src/styles/theme.css 保持一致的视觉语言
 * ========================================================= */
page {
  --brand: #2c6bf2;
  --brand-deep: #1b47b8;
  --brand-soft: #eef3ff;
  --cyan: #17bfd4;
  --mint: #0fb583;
  --amber: #f5a524;
  --danger: #ef4b4b;
  --gold: #c8a063;
  --ink: #12294a;
  --text: #1b2b45;
  --muted: #7a879b;
  --line: #e9eff8;
  --bg: #f4f7fc;
  --surface: #ffffff;

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text);
  -webkit-font-smoothing: antialiased;
}

/* 通用卡片 */
.card {
  background: var(--surface);
  border-radius: 28rpx;
  padding: 30rpx;
  margin: 24rpx;
  box-shadow: 0 16rpx 44rpx rgba(18, 41, 74, 0.07);
}

/* 区块标题行 */
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  padding-left: 20rpx;
  border-left: 8rpx solid var(--brand);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
}

.section-more,
.section-tip {
  font-size: 23rpx;
  color: var(--brand);
  font-weight: 500;
}

.section-tip {
  color: var(--muted);
  font-weight: 400;
}

/* 页面顶部渐变头部（各页复用） */
.page-hero {
  position: relative;
  padding: 36rpx 32rpx 48rpx;
  background: linear-gradient(135deg, #1b47b8 0%, #2c6bf2 52%, #17bfd4 100%);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.page-hero-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.page-hero-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

/* 装饰圆：提升头部层次 */
.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  pointer-events: none;
}

.hero-deco-a {
  width: 280rpx;
  height: 280rpx;
  right: -90rpx;
  top: -110rpx;
}

.hero-deco-b {
  width: 150rpx;
  height: 150rpx;
  right: 110rpx;
  bottom: -70rpx;
}

/* 主按钮 */
.btn-primary {
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #ffffff;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  box-shadow: 0 14rpx 30rpx rgba(44, 107, 242, 0.28);
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  background: #c3d4f7;
  color: #ffffff;
  box-shadow: none;
}

/* 次要按钮 */
.btn-default {
  height: 88rpx;
  line-height: 88rpx;
  background: #f2f5fa;
  color: #5b6b7c;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-default::after {
  border: none;
}

/* 胶囊标签 */
.tag {
  display: inline-block;
  padding: 5rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.5;
}

.tag-pending {
  color: #b87605;
  background: rgba(245, 165, 36, 0.14);
}

.tag-progress {
  color: #2c6bf2;
  background: rgba(44, 107, 242, 0.12);
}

.tag-finished {
  color: #0b9c72;
  background: rgba(15, 181, 131, 0.13);
}

.tag-rejected {
  color: #d63c3c;
  background: rgba(239, 75, 75, 0.12);
}

/* 空状态 */
.empty {
  text-align: center;
  color: var(--muted);
  padding: 120rpx 0;
  font-size: 26rpx;
}

.empty-state {
  padding: 110rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin: 0 auto 26rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #eef3ff, #e6f8fb);
  color: var(--brand);
  font-size: 54rpx;
  font-weight: 700;
}

.empty-text {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 32rpx;
}

.empty-btn {
  display: inline-block;
  padding: 18rpx 60rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 26rpx rgba(44, 107, 242, 0.24);
}

.loading-text {
  text-align: center;
  color: #a6b1c2;
  font-size: 24rpx;
  padding: 26rpx 0;
}

/* 表单通用 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #5b6b7c;
}

.form-label .required {
  color: var(--danger);
  margin-right: 6rpx;
}

.form-input {
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}

.form-input:focus {
  border-color: var(--brand);
  background: #ffffff;
}

/* 下拉选择行 */
.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  border-radius: 18rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}

.picker-placeholder {
  color: #b3bcc7;
}

.picker-arrow {
  color: #b3bcc7;
  font-size: 32rpx;
}
