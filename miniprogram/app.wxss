/* 全局样式：主色 #3b7cff，卡片式布局 */
page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #333;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 主按钮 */
.btn-primary {
  background: #3b7cff;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-primary[disabled] {
  background: #b8ccef;
  color: #fff;
}

/* 次要按钮 */
.btn-default {
  background: #f0f2f5;
  color: #333;
  border-radius: 44rpx;
  font-size: 30rpx;
}

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  color: #999;
  padding: 120rpx 0;
  font-size: 26rpx;
}

/* 表单通用 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  display: block;
}

.form-input {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}
