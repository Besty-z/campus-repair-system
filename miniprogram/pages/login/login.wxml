<!-- 登录/注册一体页 -->
<!-- 课程演示提示：预置管理员手机号 13800000000，验证码查看后端控制台日志 -->
<view class="login-page">
  <view class="login-hero">
    <!-- 品牌区样板背景图 + 深蓝渐变遮罩，保证文字可读 -->
    <image class="hero-bg" src="{{loginBg}}" mode="aspectFill" lazy-load />
    <view class="hero-mask"></view>
    <view class="hero-circle hero-circle-a"></view>
    <view class="hero-circle hero-circle-b"></view>
    <view class="hero-deco-line"></view>

    <view class="brand-logo">修</view>
    <view class="brand-title">校园报修预约系统</view>
    <view class="brand-sub">宿舍与校园公共区域 · 一键报修 · 进度可查</view>

    <view class="brand-chips">
      <view class="brand-chip">手机号登录</view>
      <view class="brand-chip">多图报修</view>
      <view class="brand-chip">全程可查</view>
    </view>
  </view>

  <view class="card login-card">
    <view class="login-tabs">
      <view class="login-tab login-tab-active">登录</view>
      <view class="login-tab">注册</view>
    </view>
    <view class="welcome-title">欢迎使用</view>
    <view class="welcome-desc">未注册的手机号将自动创建账号</view>

    <view class="form-item">
      <text class="form-label">手机号</text>
      <view class="phone-field">
        <text class="phone-prefix">+86</text>
        <input class="phone-input" type="number" maxlength="11" placeholder="请输入手机号"
               value="{{phone}}" bindinput="onPhoneInput" />
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">验证码</text>
      <view class="code-row">
        <input class="form-input code-input" type="number" maxlength="6" placeholder="请输入验证码"
               value="{{code}}" bindinput="onCodeInput" />
        <button class="code-btn {{counting > 0 ? 'code-btn-disabled' : ''}}" size="mini"
                bindtap="sendCode" disabled="{{counting > 0 || sending}}">
          {{counting > 0 ? counting + 's 后重发' : (sending ? '发送中…' : '获取验证码')}}
        </button>
      </view>
      <view class="tip">课程演示：验证码请查看后端控制台日志</view>
    </view>

    <button class="btn-primary login-btn" bindtap="login" loading="{{logging}}" disabled="{{logging}}">
      登录 / 注册
    </button>
  </view>

  <view class="admin-tip">管理员演示账号：13800000000</view>
</view>
