<!-- 登录/注册一体页 -->
<!-- 课程演示提示：预置管理员手机号 13800000000，验证码查看后端控制台日志 -->
<view class="login-page">
  <view class="logo-area">
    <view class="logo-icon">🛠</view>
    <view class="logo-title">校园报修预约系统</view>
    <view class="logo-sub">手机号验证码登录 / 自动注册</view>
  </view>

  <view class="card form-card">
    <view class="form-item">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号"
             value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view class="form-item">
      <text class="form-label">验证码</text>
      <view class="code-row">
        <input class="form-input code-input" type="number" maxlength="6" placeholder="请输入验证码"
               value="{{code}}" bindinput="onCodeInput" />
        <button class="code-btn {{counting > 0 ? 'code-btn-disabled' : ''}}" size="mini"
                bindtap="sendCode" disabled="{{counting > 0 || sending}}">
          {{counting > 0 ? counting + 's 后重发' : (sending ? '发送中…' : '获取验证码')}}
        </button>
      </view>
      <view class="tip">课程演示：验证码请查看后端控制台日志</view>
    </view>

    <button class="btn-primary login-btn" bindtap="login" loading="{{logging}}" disabled="{{logging}}">
      登录 / 注册
    </button>
  </view>

  <view class="admin-tip">提示：管理员账号手机号为 13800000000</view>
</view>
