.login-page {
  padding: 40rpx 0;
}

.logo-area {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.logo-icon {
  font-size: 90rpx;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-top: 16rpx;
}

.logo-sub {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.form-card {
  margin: 20rpx 30rpx;
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  margin-right: 20rpx;
}

.code-btn {
  background: #3b7cff;
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
  white-space: nowrap;
}

.code-btn-disabled {
  background: #b8ccef;
}

.tip {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.login-btn {
  margin-top: 20rpx;
}

.admin-tip {
  text-align: center;
  color: #bbb;
  font-size: 22rpx;
  margin-top: 30rpx;
}
