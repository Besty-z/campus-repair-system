/* 登录页样式：品牌渐变头部 + 白色圆角表单卡 */

.login-page {
  min-height: 100vh;
  background: var(--bg);
}

/* 品牌头部 */
.login-hero {
  position: relative;
  padding: 96rpx 44rpx 130rpx;
  background: linear-gradient(135deg, #1b47b8 0%, #2c6bf2 52%, #17bfd4 100%);
  border-radius: 0 0 56rpx 56rpx;
  overflow: hidden;
}

/* 背景图铺满品牌区 */
.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* 深蓝渐变遮罩：压暗背景图，保证品牌文字对比度 */
.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(18, 41, 74, 0.62) 0%, rgba(27, 71, 184, 0.58) 55%, rgba(44, 107, 242, 0.5) 100%);
}

.hero-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.13);
}

.hero-circle-a {
  width: 320rpx;
  height: 320rpx;
  right: -120rpx;
  top: -130rpx;
}

.hero-circle-b {
  width: 190rpx;
  height: 190rpx;
  left: -80rpx;
  bottom: -90rpx;
}

.hero-deco-line {
  position: absolute;
  right: 40rpx;
  bottom: 52rpx;
  width: 220rpx;
  height: 220rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 50%;
}

.brand-logo {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  text-align: center;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.48);
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
}

.brand-title {
  position: relative;
  margin-top: 26rpx;
  font-size: 42rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.brand-sub {
  position: relative;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.brand-chips {
  position: relative;
  display: flex;
  margin-top: 30rpx;
}

.brand-chip {
  margin-right: 14rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 登录表单卡片 */
.login-card {
  position: relative;
  z-index: 2;
  margin: -84rpx 32rpx 0;
  padding: 40rpx 36rpx 44rpx;
  border-radius: 32rpx;
  box-shadow: 0 20rpx 52rpx rgba(18, 41, 74, 0.1);
}

.login-tabs {
  display: flex;
  padding: 6rpx;
  margin-bottom: 30rpx;
  background: #f3f6fc;
  border-radius: 999rpx;
}

.login-tab {
  flex: 1;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  border-radius: 999rpx;
}

.login-tab-active {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  box-shadow: 0 8rpx 18rpx rgba(44, 107, 242, 0.24);
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.welcome-desc {
  margin-top: 8rpx;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* 手机号输入：+86 前缀 */
.phone-field {
  display: flex;
  align-items: center;
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  border-radius: 18rpx;
  padding: 0 24rpx;
}

.phone-prefix {
  padding-right: 20rpx;
  margin-right: 20rpx;
  border-right: 2rpx solid #e4ebf6;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  line-height: 44rpx;
}

.phone-input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--text);
}

.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  margin-right: 20rpx;
}

.code-btn {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0 28rpx;
  background: linear-gradient(135deg, #eef3ff, #e6f8fb);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 18rpx;
  white-space: nowrap;
}

.code-btn::after {
  border: none;
}

.code-btn-disabled {
  background: #f2f5fa;
  color: #a6b1c2;
}

.tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #a6b1c2;
}

.login-btn {
  margin-top: 36rpx;
}

.admin-tip {
  margin-top: 40rpx;
  text-align: center;
  color: #a6b1c2;
  font-size: 22rpx;
}
