<!-- 工单详情 -->
<view class="detail-page" wx:if="{{order}}">
  <!-- 状态头部 -->
  <view class="status-banner" style="background: {{order.statusColor}};">
    <view class="banner-deco banner-deco-a"></view>
    <view class="banner-deco banner-deco-b"></view>
    <view class="status-tag">工单状态</view>
    <view class="status-text">{{order.statusText}}</view>
    <view class="status-desc">{{order.statusDesc}}</view>
    <view class="banner-foot">
      <text class="order-no-text">工单号 {{order.orderNo}}</text>
      <text class="urgent-text" wx:if="{{order.urgent === 1}}">紧急 · 优先处理</text>
    </view>
  </view>

  <!-- 维修进度 -->
  <view class="card progress-card" wx:if="{{order.status !== 'REJECTED'}}">
    <view class="section-head">
      <text class="section-title">维修进度</text>
    </view>
    <view class="timeline">
      <view class="tl-item" wx:for="{{steps}}" wx:key="index">
        <view class="tl-left">
          <view class="tl-dot {{item.done ? 'tl-dot-done' : ''}}"></view>
          <view class="tl-line" wx:if="{{index < steps.length - 1}}"></view>
        </view>
        <view class="tl-content">
          <view class="tl-name {{item.done ? 'tl-name-done' : ''}}">{{item.name}}</view>
          <view class="tl-time">{{item.time || '待处理'}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 驳回原因 -->
  <view class="card reject-card" wx:else>
    <view class="reject-title">工单已驳回</view>
    <view class="reject-desc">{{order.adminRemark || '请联系维修管理员了解详情'}}</view>
  </view>

  <!-- 基本信息 -->
  <view class="card">
    <view class="section-head">
      <text class="section-title">报修信息</text>
    </view>
    <view class="info-row"><text class="info-label">地点类型</text><text class="info-value">{{order.locationTypeText}}</text></view>
    <view class="info-row"><text class="info-label">具体地点</text><text class="info-value">{{order.locationText}}</text></view>
    <view class="info-row">
      <text class="info-label">故障分类</text>
      <view class="info-value cat-chip-list" wx:if="{{order.categoryNames && order.categoryNames.length > 0}}">
        <text class="tag cat-chip" wx:for="{{order.categoryNames}}" wx:key="*this">{{item}}</text>
      </view>
      <text class="info-value" wx:else>{{order.categoryName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">预估费用</text>
      <text class="info-value price-text">{{order.estimatedText}}</text>
    </view>
    <view class="info-row"><text class="info-label">故障描述</text><text class="info-value">{{order.description}}</text></view>
    <view class="info-row" wx:if="{{order.appointmentTime}}">
      <text class="info-label">预约时间</text><text class="info-value">{{order.appointmentTime}}</text>
    </view>
  </view>

  <!-- 维修人员信息 -->
  <view class="card" wx:if="{{order.workerName || order.workerPhone}}">
    <view class="section-head">
      <text class="section-title">维修人员</text>
    </view>
    <view class="info-row" wx:if="{{order.workerName}}">
      <text class="info-label">维修工</text><text class="info-value">{{order.workerName}}</text>
    </view>
    <view class="info-row" wx:if="{{order.workerPhone}}">
      <text class="info-label">联系电话</text><text class="info-value">{{order.workerPhone}}</text>
    </view>
  </view>

  <!-- 服务评价 -->
  <view class="card rate-card" wx:if="{{order.ratingScore}}">
    <view class="section-head">
      <text class="section-title">服务评价</text>
      <text class="section-tip" wx:if="{{order.ratingTime}}">{{order.ratingTime}}</text>
    </view>
    <view class="rate-score-line">
      <text class="rate-score">{{order.ratingScore}}</text>
      <text class="rate-unit">分</text>
    </view>
    <view class="rate-comment" wx:if="{{order.ratingComment}}">{{order.ratingComment}}</view>
    <view class="rate-comment rate-empty" wx:else>未填写文字评价</view>
  </view>

  <!-- 故障图片九宫格：无照片时展示样板占位图 -->
  <view class="card">
    <view class="section-head">
      <text class="section-title">故障图片</text>
      <text class="section-tip" wx:if="{{imageUrls.length > 0}}">共 {{imageUrls.length}} 张</text>
    </view>
    <view class="img-grid" wx:if="{{imageUrls.length > 0}}">
      <image wx:for="{{imageUrls}}" wx:key="index" src="{{item}}" mode="aspectFill" lazy-load
             class="grid-img" data-index="{{index}}" bindtap="previewImage" />
    </view>
    <image wx:else class="empty-img" src="{{emptyImage}}" mode="aspectFill" lazy-load />
  </view>

  <!-- 维修备注 -->
  <view class="card remark-card" wx:if="{{order.adminRemark && order.status !== 'REJECTED'}}">
    <view class="section-head">
      <text class="section-title">维修备注</text>
    </view>
    <view class="remark-text">{{order.adminRemark}}</view>
  </view>

  <!-- 评价维修（报修人 + 已完成 + 未评价） -->
  <view class="rate-action" wx:if="{{canRate}}">
    <button class="btn-primary" bindtap="openRate">评价维修</button>
  </view>

  <!-- 时间与报修人信息 -->
  <view class="card">
    <view class="section-head">
      <text class="section-title">进度信息</text>
    </view>
    <view class="info-row"><text class="info-label">报修人</text><text class="info-value">{{order.userNickname}}（{{order.userPhone}}）</text></view>
    <view class="info-row"><text class="info-label">提交时间</text><text class="info-value">{{order.createTime}}</text></view>
    <view class="info-row" wx:if="{{order.acceptTime}}"><text class="info-label">接单时间</text><text class="info-value">{{order.acceptTime}}</text></view>
    <view class="info-row" wx:if="{{order.finishTime}}"><text class="info-label">完成时间</text><text class="info-value">{{order.finishTime}}</text></view>
  </view>

  <!-- 评价弹窗 -->
  <view class="modal-mask" wx:if="{{showRateModal}}" bindtap="hideRate">
    <view class="modal-body" catchtap="noop">
      <view class="modal-title">评价维修服务</view>
      <view class="star-row">
        <text class="star {{item <= formScore ? 'star-active' : ''}}"
              wx:for="{{stars}}" wx:key="*this"
              data-score="{{item}}" bindtap="onScoreTap">★</text>
      </view>
      <view class="star-tip">{{formScore}} 星</view>
      <view class="form-item">
        <text class="form-label">评价内容</text>
        <textarea class="form-textarea" placeholder="说说本次维修体验（可选）"
                  value="{{formComment}}" bindinput="onCommentInput" maxlength="200" />
      </view>
      <view class="modal-actions">
        <button class="btn-default modal-btn" bindtap="hideRate">取消</button>
        <button class="btn-primary modal-btn" disabled="{{submitting}}" bindtap="submitRating">提交评价</button>
      </view>
    </view>
  </view>
</view>

<view class="empty" wx:else>加载中…</view>
