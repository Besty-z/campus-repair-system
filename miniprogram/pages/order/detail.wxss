/* 工单详情样式 */

.detail-page {
  padding-bottom: 40rpx;
}

/* 状态头部：底色由状态动态设置，叠加渐变提升质感 */
.status-banner {
  position: relative;
  padding: 44rpx 32rpx 52rpx;
  color: #ffffff;
  overflow: hidden;
  border-radius: 0 0 40rpx 40rpx;
}

.status-banner::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(18, 41, 74, 0.22) 100%);
  pointer-events: none;
}

.banner-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.banner-deco-a {
  width: 300rpx;
  height: 300rpx;
  right: -100rpx;
  top: -120rpx;
}

.banner-deco-b {
  width: 140rpx;
  height: 140rpx;
  right: 90rpx;
  bottom: -70rpx;
}

.status-tag {
  position: relative;
  z-index: 2;
  display: inline-block;
  padding: 5rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

.status-text {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.status-desc {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.84);
}

.banner-foot {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}

.order-no-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

.urgent-text {
  padding: 5rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

/* 维修进度时间线 */
.timeline {
  padding: 8rpx 0 0;
}

.tl-item {
  display: flex;
}

.tl-left {
  width: 46rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.tl-dot {
  width: 22rpx;
  height: 22rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #dfe6f0;
  box-sizing: border-box;
}

.tl-dot-done {
  background: linear-gradient(135deg, #2c6bf2, #17bfd4);
  box-shadow: 0 0 0 6rpx rgba(44, 107, 242, 0.13);
}

.tl-line {
  flex: 1;
  width: 2rpx;
  margin: 10rpx 0;
  background: #e9eff8;
  min-height: 44rpx;
}

.tl-content {
  flex: 1;
  padding-bottom: 32rpx;
}

.tl-item:last-child .tl-content {
  padding-bottom: 0;
}

.tl-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #a6b1c2;
}

.tl-name-done {
  color: var(--ink);
}

.tl-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #a6b1c2;
}

/* 驳回卡片 */
.reject-card {
  background: linear-gradient(135deg, #fff7f7, #fff1f1);
  border: 2rpx solid #ffdede;
}

.reject-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--danger);
}

.reject-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #a05a5a;
}

/* 信息行 */
.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  width: 150rpx;
  flex-shrink: 0;
  color: #98a5b8;
}

.info-value {
  flex: 1;
  color: var(--text);
  word-break: break-all;
}

/* 图片九宫格 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-img {
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
}

/* 维修备注 */
.remark-card {
  background: linear-gradient(135deg, #f7fbff, #f2f9fb);
  border: 2rpx solid #e6f2f7;
}

.remark-text {
  color: #4b5f7a;
  font-size: 26rpx;
  line-height: 1.75;
}
