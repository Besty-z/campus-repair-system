/* 我的工单列表样式 */

.list-page {
  padding-bottom: 30rpx;
}

/* 状态筛选 */
.tabs {
  background: rgba(244, 247, 252, 0.96);
  white-space: nowrap;
  padding: 20rpx 20rpx 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  box-sizing: border-box;
}

.tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 14rpx;
  font-size: 26rpx;
  color: #5b6b7c;
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 999rpx;
}

.tab-active {
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  border-color: transparent;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(44, 107, 242, 0.24);
}

/* 工单卡片 */
.order-card {
  position: relative;
  padding: 30rpx 28rpx 24rpx;
  border-radius: 28rpx;
  margin: 0 24rpx 24rpx;
}

.order-urgent {
  background: linear-gradient(180deg, #fff8f8 0%, #ffffff 40%);
  box-shadow: 0 16rpx 44rpx rgba(239, 75, 75, 0.1);
}

.order-urgent::before {
  content: '';
  position: absolute;
  left: 0;
  top: 34rpx;
  bottom: 34rpx;
  width: 8rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: var(--danger);
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f2f6fb;
}

.order-mark {
  width: 8rpx;
  height: 44rpx;
  margin-right: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #2c6bf2, #17bfd4);
  flex-shrink: 0;
}

.order-title-wrap {
  flex: 1;
  min-width: 0;
}

.order-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 多选分类小标签 */
.cat-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  white-space: normal;
  overflow: visible;
}

.cat-chip {
  margin-right: 10rpx;
  margin-bottom: 4rpx;
  color: var(--brand);
  background: var(--brand-soft);
}

.order-no {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a6b1c2;
}

.head-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.urgent-tag {
  margin-right: 10rpx;
  padding: 3rpx 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--danger);
  background: rgba(239, 75, 75, 0.1);
  border-radius: 999rpx;
}

.order-body {
  padding: 20rpx 0 4rpx;
}

.order-row {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.row-label {
  width: 130rpx;
  flex-shrink: 0;
  color: #98a5b8;
}

.row-value {
  flex: 1;
  color: var(--text);
  word-break: break-all;
}

/* 预估费用：橙色强调，面议同样醒目 */
.order-price {
  font-weight: 600;
  color: #ff6b00;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 2rpx solid #f2f6fb;
}

.order-time {
  font-size: 22rpx;
  color: #a6b1c2;
}

.order-link {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--brand);
}
