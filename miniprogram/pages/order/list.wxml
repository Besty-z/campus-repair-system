<!-- 我的工单列表 -->
<view class="list-page">
  <!-- 状态筛选 tabs -->
  <scroll-view scroll-x class="tabs" enhanced show-scrollbar="{{false}}">
    <view class="tab {{activeTab === index ? 'tab-active' : ''}}"
          wx:for="{{tabs}}" wx:key="value"
          data-index="{{index}}" bindtap="onTabChange">{{item.label}}</view>
  </scroll-view>

  <!-- 工单卡片列表 -->
  <view class="card order-card {{item.urgent === 1 ? 'order-urgent' : ''}}"
        wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="order-head">
      <view class="order-mark"></view>
      <view class="order-title-wrap">
        <!-- 多选分类优先用小标签展示，无分类名列表时回退到 categoryName -->
        <view class="order-title cat-title" wx:if="{{item.categoryNames && item.categoryNames.length > 0}}">
          <text class="tag cat-chip" wx:for="{{item.categoryNames}}" wx:for-item="catName" wx:key="*this">{{catName}}</text>
        </view>
        <view class="order-title" wx:else>{{item.categoryName || '其他故障'}}</view>
        <view class="order-no">工单号 {{item.orderNo}}</view>
      </view>
      <view class="head-right">
        <text class="urgent-tag" wx:if="{{item.urgent === 1}}">紧急</text>
        <text class="tag" style="background: {{item.statusColor}}1a; color: {{item.statusColor}};">{{item.statusText}}</text>
      </view>
    </view>

    <view class="order-body">
      <view class="order-row">
        <text class="row-label">报修地点</text>
        <text class="row-value">{{item.locationText}}</text>
      </view>
      <view class="order-row">
        <text class="row-label">预估费用</text>
        <text class="row-value order-price">{{item.estimatedText}}</text>
      </view>
      <view class="order-row" wx:if="{{item.descSummary}}">
        <text class="row-label">故障描述</text>
        <text class="row-value">{{item.descSummary}}</text>
      </view>
    </view>

    <view class="order-foot">
      <text class="order-time">{{item.createTime}}</text>
      <text class="order-link">查看详情 ›</text>
    </view>
  </view>

  <!-- 空状态 / 加载提示 -->
  <view class="empty-state" wx:if="{{list.length === 0 && !loading}}">
    <image class="empty-img" src="{{emptyImage}}" mode="aspectFill" lazy-load />
    <view class="empty-text">暂无工单，快去报修吧</view>
    <view class="empty-btn" bindtap="goSubmit">去报修</view>
  </view>
  <view class="loading-text" wx:if="{{loading}}">加载中…</view>
  <view class="loading-text" wx:elif="{{list.length > 0 && !hasMore}}">没有更多了</view>
</view>
