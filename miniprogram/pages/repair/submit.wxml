<!-- 提交报修页 -->
<view class="submit-page">
  <!-- 页面头部提示 -->
  <view class="page-hero">
    <view class="hero-deco hero-deco-a"></view>
    <view class="hero-deco hero-deco-b"></view>
    <view class="page-hero-title">提交报修</view>
    <view class="page-hero-desc">填写故障信息，维修人员将尽快处理</view>
  </view>

  <!-- 报修地点 -->
  <view class="card form-card">
    <view class="section-head">
      <text class="section-title">报修地点</text>
    </view>

    <view class="form-item">
      <text class="form-label"><text class="required">*</text>地点类型</text>
      <view class="radio-group">
        <view wx:for="{{locationTypes}}" wx:key="index"
              class="radio-item {{locationTypeIndex === index ? 'radio-active' : ''}}"
              data-index="{{index}}" bindtap="onLocationTypeChange" data-value="{{index}}">
          <view class="radio-name">{{item}}</view>
          <view class="radio-desc">{{index === 0 ? '楼号 + 房间号' : '校园具体位置'}}</view>
        </view>
      </view>
    </view>

    <block wx:if="{{locationTypeIndex === 0}}">
      <view class="form-item">
        <text class="form-label"><text class="required">*</text>楼号</text>
        <input class="form-input" placeholder="如：5号楼" value="{{buildingNo}}" bindinput="onBuildingInput" />
      </view>
      <view class="form-item">
        <text class="form-label"><text class="required">*</text>房间号</text>
        <input class="form-input" placeholder="如：302" value="{{roomNo}}" bindinput="onRoomInput" />
      </view>
    </block>

    <view class="form-item" wx:else>
      <text class="form-label"><text class="required">*</text>具体位置</text>
      <input class="form-input" placeholder="如：图书馆东侧道路" value="{{publicLocation}}" bindinput="onPublicLocationInput" />
    </view>
  </view>

  <!-- 故障信息 -->
  <view class="card form-card">
    <view class="section-head">
      <text class="section-title">故障信息</text>
    </view>

    <view class="form-item">
      <text class="form-label"><text class="required">*</text>故障分类</text>
      <picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">
        <view class="picker-row {{categoryIndex < 0 ? 'picker-placeholder' : ''}}">
          <text>{{categoryIndex >= 0 ? categories[categoryIndex].name : '请选择故障分类'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-item" wx:if="{{isOtherCategory}}">
      <text class="form-label"><text class="required">*</text>故障类型</text>
      <input class="form-input" placeholder="请填写故障类型（不超过50字）" maxlength="50"
             value="{{customCategory}}" bindinput="onCustomCategoryInput" />
    </view>

    <view class="form-item desc-item">
      <text class="form-label"><text class="required">*</text>故障描述</text>
      <textarea class="form-input desc-input" placeholder="请描述故障情况，便于维修人员提前准备" maxlength="500"
                value="{{description}}" bindinput="onDescInput" />
    </view>
  </view>

  <!-- 故障图片 -->
  <view class="card form-card">
    <view class="section-head">
      <text class="section-title">故障图片</text>
      <text class="section-tip">{{isVip ? '最多 5 张' : '普通用户最多 1 张'}}</text>
    </view>
    <view class="img-grid">
      <view class="img-cell" wx:for="{{images}}" wx:key="index">
        <image src="{{imgBaseUrl + item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage" />
        <view class="img-del" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
      <view class="img-add" bindtap="chooseImage" wx:if="{{images.length < (isVip ? 5 : 1)}}">
        <view class="img-add-plus">+</view>
        <view class="img-add-text">添加图片</view>
      </view>
    </view>
  </view>

  <!-- VIP 专属：预约上门时间 + 紧急报修 -->
  <view class="card vip-card" wx:if="{{isVip}}">
    <view class="section-head">
      <text class="section-title vip-section-title">会员专属</text>
      <text class="vip-badge">VIP</text>
    </view>
    <view class="form-item">
      <text class="form-label">预约上门时间（可选）</text>
      <picker mode="multiSelector" range="{{appointmentRange}}" value="{{appointmentIndex}}"
              bindchange="onAppointmentChange" bindcolumnchange="onAppointmentColumnChange">
        <view class="picker-row {{!appointmentText ? 'picker-placeholder' : ''}}">
          <text>{{appointmentText || '请选择日期和时间段'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="form-item switch-row">
      <view class="switch-text">
        <text class="form-label switch-label">紧急报修</text>
        <text class="switch-desc">开启后工单将优先展示和处理</text>
      </view>
      <switch checked="{{urgent}}" bindchange="onUrgentChange" color="#ef4b4b" />
    </view>
  </view>

  <!-- 普通用户：会员引导 -->
  <view class="card vip-guide" wx:else>
    <view class="vip-guide-head">
      <text class="vip-guide-title">会员专享权益</text>
      <text class="vip-guide-badge">VIP</text>
    </view>
    <view class="vip-guide-desc">上传最多 5 张图片 · 自选预约上门时间 · 紧急报修优先处理</view>
  </view>

  <button class="btn-primary submit-btn" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">
    {{submitting ? '提交中…' : '提交报修'}}
  </button>
</view>
