/* 提交报修页样式 */

.submit-page {
  padding-bottom: 60rpx;
}

.form-card {
  position: relative;
  padding: 32rpx 30rpx;
}

/* 表单最后一项去掉多余间距 */
.form-card .form-item:last-child {
  margin-bottom: 0;
}

/* 地点类型选择：卡片式单选 */
.radio-group {
  display: flex;
}

.radio-item {
  flex: 1;
  padding: 26rpx 16rpx;
  margin-right: 18rpx;
  border-radius: 20rpx;
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  text-align: center;
  transition: all 0.2s;
}

.radio-item:last-child {
  margin-right: 0;
}

.radio-active {
  background: linear-gradient(135deg, #f4f7ff, #edfbfd);
  border-color: var(--brand);
  box-shadow: 0 8rpx 20rpx rgba(44, 107, 242, 0.12);
}

.radio-name {
  font-size: 28rpx;
  color: #5b6b7c;
  font-weight: 600;
}

.radio-active .radio-name {
  color: var(--brand);
}

.radio-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #a6b1c2;
}

/* 故障分类：多选标签，选中态用品牌渐变 */
.cat-tags {
  display: flex;
  flex-wrap: wrap;
}

.cat-tag {
  display: flex;
  align-items: center;
  padding: 14rpx 28rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  font-size: 26rpx;
  color: #5b6b7c;
  transition: all 0.2s;
}

/* 分类单价：橙色强调 */
.cat-price {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ff6b00;
}

.cat-tag-active .cat-price {
  color: rgba(255, 255, 255, 0.92);
}

.cat-tag-active {
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  border-color: transparent;
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(44, 107, 242, 0.24);
}

/* 费用预估 */
.estimate-card {
  background: linear-gradient(180deg, #fffdf9 0%, #ffffff 60%);
  border: 2rpx solid #ffe8d6;
}

.estimate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 25rpx;
}

.estimate-name {
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.estimate-price {
  flex-shrink: 0;
  margin-left: 20rpx;
  font-weight: 600;
  color: var(--ink);
}

.estimate-total {
  margin-top: 6rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed #f3e2d2;
}

.estimate-total .estimate-price {
  font-size: 30rpx;
  color: #ff6b00;
}

.estimate-discount .estimate-name,
.estimate-discount .estimate-price {
  color: #b98d51;
}

.estimate-final {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f7ece2;
}

.final-label {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
}

.final-price {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff6b00;
  line-height: 1.1;
}

.estimate-tip {
  margin-top: 12rpx;
  font-size: 21rpx;
  line-height: 1.6;
  color: #a6b1c2;
}

.estimate-tip-member {
  color: #b98d51;
}

.estimate-empty {
  padding: 16rpx 0;
  font-size: 24rpx;
  color: var(--muted);
}

/* 故障描述 */
.desc-item {
  margin-bottom: 0;
}

.desc-input {
  width: 100%;
  height: 210rpx;
  line-height: 1.6;
  padding: 22rpx 24rpx;
}

/* 图片上传 */
.img-grid {
  display: flex;
  flex-wrap: wrap;
}

.img-cell,
.img-add {
  width: 196rpx;
  height: 196rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 20rpx;
  overflow: visible;
}

.img-cell {
  position: relative;
}

.img-cell image {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  background: rgba(18, 41, 74, 0.7);
  color: #ffffff;
  border-radius: 50%;
  font-size: 26rpx;
}

.img-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f6f8fd;
  border: 2rpx dashed #c6d4e8;
  box-sizing: border-box;
}

.img-add-plus {
  font-size: 54rpx;
  color: #9fb0c9;
  line-height: 1;
}

.img-add-text {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #9fb0c9;
}

/* 会员专区 */
.vip-card {
  background: linear-gradient(135deg, #fffaf0, #fff5e2);
  border: 2rpx solid #fbeccd;
}

.vip-section-title {
  color: #8a6a33;
  border-left-color: #c8a063;
}

.vip-badge {
  padding: 3rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #b98d51, #e6c78b);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
}

.switch-text {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.switch-label {
  margin-bottom: 0;
}

.switch-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a08a63;
}

/* 普通用户会员引导 */
.vip-guide {
  background: linear-gradient(135deg, #fffdf8, #fff8ec);
  border: 2rpx solid #f8eccf;
}

.vip-guide-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.vip-guide-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #8a6a33;
}

.vip-guide-badge {
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #b98d51, #e6c78b);
}

.vip-guide-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #a08050;
}

/* 提交按钮 */
.submit-btn {
  margin: 40rpx 24rpx 20rpx;
}
