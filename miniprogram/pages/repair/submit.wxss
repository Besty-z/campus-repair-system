.submit-page {
  padding-bottom: 40rpx;
}

.radio-group {
  display: flex;
  gap: 20rpx;
}

.radio-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  background: #f7f8fa;
  color: #666;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.radio-active {
  background: #eaf1ff;
  color: #3b7cff;
  border-color: #3b7cff;
}

.picker-text {
  color: #333;
}

.picker-placeholder {
  color: #b2b2b2;
}

.desc-input {
  height: 180rpx;
  width: auto;
}

.img-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.img-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}

.img-cell image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.img-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.img-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  color: #ccc;
}

.vip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #c8a063;
  margin-bottom: 20rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-label {
  margin-bottom: 0;
}

.vip-guide {
  color: #999;
  font-size: 24rpx;
  background: #fafafa;
}

.submit-btn {
  margin: 30rpx 20rpx;
}
