/* 我的页面样式 */

.mine-page {
  padding-bottom: 40rpx;
}

/* 用户信息头部 */
.profile-hero {
  position: relative;
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 4rpx;
  padding: 44rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1b47b8 0%, #2c6bf2 52%, #17bfd4 100%);
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(44, 107, 242, 0.26);
}

.hero-deco-a {
  position: absolute;
  right: -80rpx;
  top: -100rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero-deco-b {
  position: absolute;
  left: 120rpx;
  bottom: -90rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.profile-hero.guest {
  background: linear-gradient(135deg, #8a9bb2, #b7c6d4);
  box-shadow: 0 18rpx 40rpx rgba(120, 140, 160, 0.2);
}

.avatar {
  position: relative;
  z-index: 2;
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  flex-shrink: 0;
  margin-right: 26rpx;
  border-radius: 32rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.24);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 700;
}

.profile-main {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-right: 14rpx;
}

.role-badge {
  padding: 3rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #1b47b8;
  background: rgba(255, 255, 255, 0.92);
}

.phone {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.86);
}

.profile-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
}

.guest-btn {
  margin-top: 18rpx;
  padding: 0 32rpx;
  height: 62rpx;
  line-height: 62rpx;
  background: #ffffff;
  color: #1b47b8;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.guest-btn::after {
  border: none;
}

/* 功能菜单 */
.menu-card {
  padding: 30rpx 28rpx 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f2f6fb;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
  border-radius: 22rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
}

.icon-blue {
  background: linear-gradient(135deg, #2c6bf2, #4f9ff5);
  box-shadow: 0 8rpx 18rpx rgba(44, 107, 242, 0.22);
}

.icon-orange {
  background: linear-gradient(135deg, #f5a524, #f8cf74);
  box-shadow: 0 8rpx 18rpx rgba(245, 165, 36, 0.22);
}

.icon-gold {
  background: linear-gradient(135deg, #b98d51, #e6c78b);
  box-shadow: 0 8rpx 18rpx rgba(200, 160, 99, 0.22);
}

.icon-green {
  background: linear-gradient(135deg, #0fb583, #4dd9ae);
  box-shadow: 0 8rpx 18rpx rgba(15, 181, 131, 0.2);
}

.icon-purple {
  background: linear-gradient(135deg, #6f5ce0, #a99bf0);
  box-shadow: 0 8rpx 18rpx rgba(111, 92, 224, 0.2);
}

.icon-cyan {
  background: linear-gradient(135deg, #17bfd4, #7fd6f2);
  box-shadow: 0 8rpx 18rpx rgba(23, 191, 212, 0.2);
}

.menu-text {
  flex: 1;
  min-width: 0;
}

.menu-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.menu-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #a6b1c2;
}

.menu-arrow {
  color: #c3ccd6;
  font-size: 34rpx;
}

/* 退出登录 */
.logout-btn {
  margin: 36rpx 24rpx 20rpx;
}

.mine-footer {
  text-align: center;
  font-size: 20rpx;
  color: #a6b1c2;
  padding: 10rpx 0 20rpx;
}
