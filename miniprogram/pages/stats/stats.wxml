<!-- 会员报修统计 -->
<view class="stats-page" wx:if="{{stats}}">
  <!-- 总览头卡 -->
  <view class="stat-hero">
    <view class="hero-deco-a"></view>
    <view class="hero-deco-b"></view>
    <view class="stat-hero-label">我的报修总量</view>
    <view class="stat-hero-value">{{stats.total}}</view>
    <view class="stat-hero-desc">会员数据概览 · 随时掌握报修进度</view>
  </view>

  <!-- 数字卡片 -->
  <view class="num-grid">
    <view class="num-card">
      <view class="num-dot dot-amber"></view>
      <view class="num-value">{{stats.pending}}</view>
      <view class="num-label">待接单</view>
    </view>
    <view class="num-card">
      <view class="num-dot dot-brand"></view>
      <view class="num-value">{{stats.inProgress}}</view>
      <view class="num-label">维修中</view>
    </view>
    <view class="num-card">
      <view class="num-dot dot-mint"></view>
      <view class="num-value">{{stats.finished}}</view>
      <view class="num-label">已完成</view>
    </view>
    <view class="num-card">
      <view class="num-dot dot-danger"></view>
      <view class="num-value">{{stats.rejected}}</view>
      <view class="num-label">驳回</view>
    </view>
  </view>

  <!-- 分类分布（进度条列表，零依赖） -->
  <view class="card">
    <view class="section-head">
      <text class="section-title">分类分布</text>
      <text class="section-tip">按故障类型</text>
    </view>
    <view class="empty" wx:if="{{byCategory.length === 0}}">暂无数据</view>
    <view class="bar-row" wx:for="{{byCategory}}" wx:key="categoryName">
      <text class="bar-name">{{item.categoryName}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{item.percent}}%;"></view>
      </view>
      <text class="bar-count">{{item.count}}</text>
    </view>
  </view>

  <!-- 按月统计 -->
  <view class="card">
    <view class="section-head">
      <text class="section-title">按月统计</text>
      <text class="section-tip">近半年提交量</text>
    </view>
    <view class="empty" wx:if="{{byMonth.length === 0}}">暂无数据</view>
    <view class="month-row" wx:for="{{byMonth}}" wx:key="month">
      <text class="month-name">{{item.month}}</text>
      <text class="month-count">{{item.count}} 单</text>
    </view>
  </view>
</view>

<view class="empty" wx:else>加载中…</view>
