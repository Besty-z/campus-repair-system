/* 会员报修统计样式 */

.stats-page {
  padding-bottom: 30rpx;
}

/* 总览头卡 */
.stat-hero {
  position: relative;
  margin: 24rpx;
  padding: 38rpx 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1b47b8 0%, #2c6bf2 52%, #17bfd4 100%);
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(44, 107, 242, 0.26);
}

.hero-deco-a {
  position: absolute;
  right: -90rpx;
  top: -110rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
}

.hero-deco-b {
  position: absolute;
  left: 140rpx;
  bottom: -80rpx;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.stat-hero-label {
  position: relative;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.stat-hero-value {
  position: relative;
  margin-top: 10rpx;
  font-size: 76rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.1;
}

.stat-hero-desc {
  position: relative;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
}

/* 统计磁贴 */
.num-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 14rpx;
}

.num-card {
  position: relative;
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 30rpx 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 36rpx rgba(18, 41, 74, 0.06);
}

.num-dot {
  position: absolute;
  right: 26rpx;
  top: 28rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.dot-amber {
  background: var(--amber);
}

.dot-brand {
  background: var(--brand);
}

.dot-mint {
  background: var(--mint);
}

.dot-danger {
  background: var(--danger);
}

.num-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.num-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* 分类分布进度条 */
.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.bar-row:last-child {
  margin-bottom: 0;
}

.bar-name {
  width: 180rpx;
  font-size: 24rpx;
  color: #5b6b7c;
  flex-shrink: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-track {
  flex: 1;
  height: 22rpx;
  background: #f1f5fb;
  border-radius: 999rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #2c6bf2 0%, #17bfd4 100%);
}

.bar-count {
  width: 76rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
  flex-shrink: 0;
}

/* 按月统计 */
.month-row {
  display: flex;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f2f6fb;
  font-size: 26rpx;
}

.month-row:last-child {
  border-bottom: none;
}

.month-name {
  color: #5b6b7c;
}

.month-count {
  color: var(--brand);
  font-weight: 600;
}
