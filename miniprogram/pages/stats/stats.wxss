.stats-page {
  padding-bottom: 30rpx;
}

.num-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 10rpx;
}

.num-card {
  width: calc(33.33% - 20rpx);
  margin: 10rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.num-total {
  color: #3b7cff;
}

.num-value {
  font-size: 48rpx;
  font-weight: 700;
}

.num-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 8rpx solid #3b7cff;
  padding-left: 16rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.bar-name {
  width: 180rpx;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  height: 24rpx;
  background: #f0f2f5;
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #3b7cff;
  border-radius: 12rpx;
}

.bar-count {
  width: 70rpx;
  text-align: right;
  font-size: 24rpx;
  color: #333;
  flex-shrink: 0;
}

.month-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  font-size: 26rpx;
}

.month-row:last-child {
  border-bottom: none;
}

.month-name {
  color: #666;
}

.month-count {
  color: #3b7cff;
  font-weight: 600;
}
