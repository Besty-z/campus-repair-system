.admin-order-page {
  padding-bottom: 30rpx;
}

.filter-bar {
  background: #fff;
  padding: 16rpx 20rpx 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs {
  white-space: nowrap;
}

.tab {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 30rpx;
  background: #f5f6fa;
}

.tab-active {
  background: #3b7cff;
  color: #fff;
}

.filter-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.filter-picker {
  flex: 1;
}

.filter-picker-text {
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: #333;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.search-input {
  flex: 1;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}

.search-btn {
  background: #3b7cff;
  color: #fff;
  border-radius: 12rpx;
}

.urgent-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #ff3b30;
}

.order-card {
  margin: 20rpx;
}

.order-urgent {
  border: 2rpx solid #ff3b30;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
}

.head-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.urgent-tag {
  color: #ff3b30;
  font-size: 22rpx;
  font-weight: 600;
  border: 2rpx solid #ff3b30;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.order-row {
  display: flex;
  margin-bottom: 10rpx;
  font-size: 26rpx;
}

.row-label {
  color: #999;
  width: 110rpx;
  flex-shrink: 0;
}

.row-value {
  color: #333;
  flex: 1;
}

.order-foot {
  color: #bbb;
  font-size: 22rpx;
  margin-top: 12rpx;
  text-align: right;
}

.action-row {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
  padding-top: 20rpx;
}

.action-btn {
  background: #f0f2f5;
  color: #333;
  border-radius: 10rpx;
  margin: 0;
}

.action-primary {
  background: #3b7cff;
  color: #fff;
}

.loading-text {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}
