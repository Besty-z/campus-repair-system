/* 分类管理（管理员）样式 */

.category-page {
  padding-bottom: 40rpx;
}

.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f2f6fb;
}

.cat-row:last-child {
  border-bottom: none;
}

.cat-info {
  flex: 1;
  min-width: 0;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.cat-disabled {
  color: #b3bcc7;
  text-decoration: line-through;
}

.cat-meta {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.cat-sort {
  font-size: 22rpx;
  color: #a6b1c2;
}

/* 服务价格：橙色强调 */
.cat-price {
  margin-right: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #ff6b00;
}

.cat-off {
  margin-left: 14rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #b87605;
  background: rgba(245, 165, 36, 0.14);
}

.cat-actions {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.cat-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 26rpx;
  background: #f2f5fa;
  color: #5b6b7c;
  border-radius: 999rpx;
  font-size: 23rpx;
  margin: 0;
}

.cat-btn::after {
  border: none;
}

.cat-btn-danger {
  background: rgba(239, 75, 75, 0.1);
  color: var(--danger);
}

.add-btn {
  margin: 34rpx 24rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 23, 40, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-body {
  width: 620rpx;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 42rpx 34rpx 34rpx;
  box-shadow: 0 24rpx 60rpx rgba(18, 41, 74, 0.24);
}

.modal-title {
  margin-bottom: 34rpx;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  color: var(--ink);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
}
