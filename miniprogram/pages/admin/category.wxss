.category-page {
  padding-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
  border-left: 8rpx solid #3b7cff;
  padding-left: 16rpx;
}

.cat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.cat-row:last-child {
  border-bottom: none;
}

.cat-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cat-name {
  font-size: 28rpx;
  color: #333;
}

.cat-disabled {
  color: #bbb;
  text-decoration: line-through;
}

.cat-sort {
  font-size: 22rpx;
  color: #999;
}

.cat-off {
  font-size: 20rpx;
  color: #ff9500;
}

.cat-actions {
  display: flex;
  gap: 12rpx;
}

.cat-btn {
  background: #f0f2f5;
  color: #333;
  border-radius: 10rpx;
  margin: 0;
}

.cat-btn-danger {
  background: #fff0ef;
  color: #ff3b30;
}

.add-btn {
  margin: 30rpx 20rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-body {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
}
