/* 维修工管理（管理员）样式 */

.worker-page {
  padding-bottom: 30rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(244, 247, 252, 0.97);
  position: sticky;
  top: 0;
  z-index: 10;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.search-btn {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 34rpx;
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.search-btn::after {
  border: none;
}

/* 维修工卡片 */
.worker-card {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
}

.worker-head {
  display: flex;
  align-items: center;
}

.worker-avatar {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #6f5ce0;
  background: rgba(111, 92, 224, 0.12);
}

.worker-info {
  flex: 1;
  min-width: 0;
}

.worker-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.worker-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.worker-phone {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #5b6b7c;
}

.worker-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.cat-chip {
  margin-right: 10rpx;
  margin-bottom: 6rpx;
  color: var(--brand);
  background: var(--brand-soft);
}

.worker-tags-empty {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #a6b1c2;
}

.worker-stats {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 18rpx 0;
  border-top: 2rpx solid #f2f6fb;
  border-bottom: 2rpx solid #f2f6fb;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--muted);
}

.worker-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.action-btn {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 28rpx;
  background: #f2f5fa;
  color: #5b6b7c;
  border-radius: 999rpx;
  font-size: 23rpx;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.action-primary {
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(44, 107, 242, 0.22);
}

.action-danger {
  background: rgba(239, 75, 75, 0.1);
  color: var(--danger);
}

.add-btn {
  margin: 34rpx 24rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(10, 23, 40, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-body {
  width: 640rpx;
  max-height: 86vh;
  overflow-y: auto;
  background: #ffffff;
  border-radius: 32rpx;
  padding: 42rpx 34rpx 34rpx;
  box-shadow: 0 24rpx 60rpx rgba(18, 41, 74, 0.24);
  box-sizing: border-box;
}

.modal-title {
  margin-bottom: 34rpx;
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  color: var(--ink);
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  font-size: 27rpx;
  color: var(--text);
  box-sizing: border-box;
}

.cat-select {
  display: flex;
  flex-wrap: wrap;
}

.cat-option {
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  color: #5b6b7c;
  background: #f2f5fa;
  border: 2rpx solid transparent;
}

.cat-option-active {
  color: var(--brand);
  background: var(--brand-soft);
  border-color: rgba(44, 107, 242, 0.3);
  font-weight: 600;
}

.empty-small {
  padding: 14rpx 0;
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 26rpx;
}

.modal-btn {
  flex: 1;
  margin: 0;
}
