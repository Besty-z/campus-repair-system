/* 用户管理（管理员）样式 */

.user-page {
  padding-bottom: 30rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(244, 247, 252, 0.97);
  position: sticky;
  top: 0;
  z-index: 10;
  box-sizing: border-box;
}

.search-input {
  flex: 1;
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 18rpx;
  padding: 16rpx 22rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.search-btn {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 34rpx;
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 600;
}

.search-btn::after {
  border: none;
}

.user-card {
  display: flex;
  align-items: center;
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
}

.user-avatar {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  flex-shrink: 0;
  margin-right: 22rpx;
  border-radius: 26rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-nickname {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-phone {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #5b6b7c;
}

.user-time {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #a6b1c2;
}

.user-actions {
  flex-shrink: 0;
  margin-left: 18rpx;
}

.role-btn {
  height: 62rpx;
  line-height: 62rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  margin: 0;
}

.role-btn::after {
  border: none;
}

.vip-btn {
  background: linear-gradient(135deg, #b98d51, #e6c78b);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(200, 160, 99, 0.22);
}

.cancel-btn {
  background: #f2f5fa;
  color: #5b6b7c;
}
