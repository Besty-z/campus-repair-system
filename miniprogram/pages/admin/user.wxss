.user-page {
  padding-bottom: 30rpx;
}

.search-bar {
  background: #fff;
  padding: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.search-input {
  flex: 1;
  background: #f5f6fa;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
}

.search-btn {
  background: #3b7cff;
  color: #fff;
  border-radius: 12rpx;
}

.user-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  flex: 1;
}

.user-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-nickname {
  font-size: 30rpx;
  font-weight: 600;
}

.user-phone {
  color: #666;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.user-time {
  color: #bbb;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.role-btn {
  border-radius: 10rpx;
  margin: 0;
}

.vip-btn {
  background: #c8a063;
  color: #fff;
}

.cancel-btn {
  background: #f0f2f5;
  color: #666;
}

.loading-text {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 24rpx 0;
}
