/* 首页样式：品牌渐变头部 + 轮播 + 快捷入口 + 流程 + 最近工单 */

.home-page {
  padding-bottom: 40rpx;
}

/* ===== 顶部渐变区 ===== */
.hero {
  position: relative;
  padding: 34rpx 24rpx 76rpx;
  background: linear-gradient(135deg, #1b47b8 0%, #2c6bf2 52%, #17bfd4 100%);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.hero-user {
  min-width: 0;
}

.hero-greeting {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hero-role,
.hero-login {
  padding: 9rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  flex-shrink: 0;
}

.hero-role {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
}

.hero-login {
  color: #1b47b8;
  background: #ffffff;
  font-weight: 600;
}

/* ===== 轮播 ===== */
.banner {
  position: relative;
  z-index: 2;
  height: 216rpx;
}

.banner-item {
  position: relative;
  height: 216rpx;
  padding: 30rpx 34rpx;
  border-radius: 26rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.banner-0 {
  background: linear-gradient(135deg, #2c6bf2, #4f9ff5);
}

.banner-1 {
  background: linear-gradient(135deg, #f5a524, #f8cf74);
}

.banner-2 {
  background: linear-gradient(135deg, #0fb583, #4dd9ae);
}

.banner-tag {
  display: inline-block;
  padding: 5rpx 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
}

.banner-title {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 轮播装饰圆：增加层次感 */
.banner-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.banner-circle-a {
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -70rpx;
}

.banner-circle-b {
  width: 120rpx;
  height: 120rpx;
  right: 80rpx;
  bottom: -50rpx;
}

/* ===== 快捷入口：上移覆盖头部 ===== */
.quick-card {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  margin-top: -54rpx;
  padding: 34rpx 10rpx 26rpx;
  border-radius: 30rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 28rpx;
  font-size: 46rpx;
  font-weight: 600;
  color: #ffffff;
}

.quick-icon-blue {
  background: linear-gradient(135deg, #2c6bf2, #4f9ff5);
  box-shadow: 0 10rpx 22rpx rgba(44, 107, 242, 0.26);
}

.quick-icon-orange {
  background: linear-gradient(135deg, #f5a524, #f8cf74);
  box-shadow: 0 10rpx 22rpx rgba(245, 165, 36, 0.26);
}

.quick-icon-gold {
  background: linear-gradient(135deg, #b98d51, #e6c78b);
  box-shadow: 0 10rpx 22rpx rgba(200, 160, 99, 0.26);
}

.quick-icon-green {
  background: linear-gradient(135deg, #0fb583, #4dd9ae);
  box-shadow: 0 10rpx 22rpx rgba(15, 181, 131, 0.24);
}

.quick-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.quick-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a6b1c2;
}

/* ===== 报修流程 ===== */
.steps {
  display: flex;
  align-items: flex-start;
}

.step {
  width: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.step-dot {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #eef3ff, #e6f8fb);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
}

.step-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}

.step-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a6b1c2;
  text-align: center;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
  margin-top: 26rpx;
}

/* ===== 最近工单 ===== */
.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f6fb;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-mark {
  width: 8rpx;
  height: 44rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-loc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-right {
  margin-left: 20rpx;
  text-align: right;
  flex-shrink: 0;
}

.recent-time {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #a6b1c2;
}

.empty-small {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

/* ===== 会员权益 ===== */
.member-card {
  background: linear-gradient(135deg, #fffaf0, #fff3dc);
  border: 2rpx solid #fbeccd;
}

.member-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #8a6a33;
}

.member-badge {
  padding: 3rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #b98d51, #e6c78b);
}

.member-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #a08050;
}

.home-footer {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #a6b1c2;
}
