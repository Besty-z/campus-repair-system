/* 首页样式：品牌渐变头部 + 轮播 + 快捷入口 + 流程 + 最近工单 */

.home-page {
  padding-bottom: 40rpx;
}

/* ===== 顶部渐变区 ===== */
.hero {
  position: relative;
  padding: 34rpx 24rpx 76rpx;
  background: linear-gradient(135deg, #1b47b8 0%, #2c6bf2 52%, #17bfd4 100%);
  border-radius: 0 0 44rpx 44rpx;
  overflow: hidden;
}

.hero-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.hero-user {
  min-width: 0;
}

.hero-greeting {
  font-size: 38rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.hero-role,
.hero-login {
  padding: 9rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  flex-shrink: 0;
}

.hero-role {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  transition: background 0.2s;
}

/* 课程演示：点击角色徽章切换身份的按压反馈 */
.hero-role-hover {
  background: rgba(255, 255, 255, 0.34);
}

.hero-login {
  color: #1b47b8;
  background: #ffffff;
  font-weight: 600;
}

/* ===== 广告轮播 ===== */
.ad-swiper {
  position: relative;
  z-index: 2;
  height: 320rpx;
  margin-bottom: 24rpx;
}

.ad-item {
  position: relative;
  height: 320rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 36rpx rgba(10, 23, 40, 0.22);
}

.ad-img {
  width: 100%;
  height: 100%;
}

/* 底部遮罩：保证标题在任意大图上可读 */
.ad-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72%;
  background: linear-gradient(180deg, rgba(10, 23, 40, 0) 0%, rgba(10, 23, 40, 0.78) 100%);
}

.ad-info {
  position: absolute;
  left: 30rpx;
  right: 30rpx;
  bottom: 28rpx;
}

.ad-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ad-subtitle {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.86);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ad-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #ff6b00;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 600;
}

/* ===== 轮播 ===== */
.banner {
  position: relative;
  z-index: 2;
  height: 216rpx;
}

.banner-item {
  position: relative;
  height: 216rpx;
  padding: 30rpx 34rpx;
  border-radius: 26rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: #1b47b8;
}

/* banner 背景图铺满 */
.banner-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* 半透明深色遮罩：保证标签、标题、描述可读 */
.banner-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(10, 23, 40, 0.62) 0%, rgba(10, 23, 40, 0.28) 100%);
}

.banner-tag {
  position: relative;
  z-index: 2;
  display: inline-block;
  padding: 5rpx 16rpx;
  font-size: 20rpx;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
}

.banner-title {
  position: relative;
  z-index: 2;
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
}

.banner-desc {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 轮播装饰圆：增加层次感 */
.banner-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.banner-circle-a {
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -70rpx;
}

.banner-circle-b {
  width: 120rpx;
  height: 120rpx;
  right: 80rpx;
  bottom: -50rpx;
}

/* ===== 快捷入口：上移覆盖头部 ===== */
.quick-card {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: flex-start;
  margin-top: -54rpx;
  padding: 34rpx 10rpx 26rpx;
  border-radius: 30rpx;
}

.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  width: 92rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 28rpx;
  font-size: 46rpx;
  font-weight: 600;
  color: #ffffff;
}

.quick-icon-blue {
  background: linear-gradient(135deg, #2c6bf2, #4f9ff5);
  box-shadow: 0 10rpx 22rpx rgba(44, 107, 242, 0.26);
}

.quick-icon-orange {
  background: linear-gradient(135deg, #f5a524, #f8cf74);
  box-shadow: 0 10rpx 22rpx rgba(245, 165, 36, 0.26);
}

.quick-icon-gold {
  background: linear-gradient(135deg, #b98d51, #e6c78b);
  box-shadow: 0 10rpx 22rpx rgba(200, 160, 99, 0.26);
}

.quick-icon-green {
  background: linear-gradient(135deg, #0fb583, #4dd9ae);
  box-shadow: 0 10rpx 22rpx rgba(15, 181, 131, 0.24);
}

.quick-icon-purple {
  background: linear-gradient(135deg, #6f5ce0, #a48bff);
  box-shadow: 0 10rpx 22rpx rgba(111, 92, 224, 0.26);
}

.quick-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.quick-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a6b1c2;
}

/* ===== 服务保障条 ===== */
.guarantee-card {
  display: flex;
  align-items: center;
  padding: 26rpx 10rpx;
  border-radius: 28rpx;
}

.guarantee-item {
  flex: 1;
  text-align: center;
  border-right: 2rpx solid #f0f4fa;
}

.guarantee-item:last-child {
  border-right: none;
}

.guarantee-value {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--brand-deep);
}

.guarantee-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--muted);
}

/* ===== 服务分类九宫格 ===== */
.service-section {
  margin: 0 24rpx;
}

.service-head {
  margin: 8rpx 0 20rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
}

/* 白底 28rpx 圆角 + 柔和投影的服务卡片（三列） */
.service-card {
  width: calc((100% - 32rpx) / 3);
  margin: 0 16rpx 20rpx 0;
  padding: 12rpx;
  background: var(--surface);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(18, 41, 74, 0.07);
  box-sizing: border-box;
  transition: transform 0.2s;
}

.service-card:nth-child(3n) {
  margin-right: 0;
}

.service-card-hover {
  transform: translateY(-4rpx);
}

.service-thumb {
  position: relative;
  height: 150rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f2f6fb;
}

.service-img {
  width: 100%;
  height: 150rpx;
  display: block;
}

/* 无服务图片时的占位（仅用文字与渐变，不新增本地图片资源） */
.service-img-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #eef3ff, #e6f8fb);
  color: var(--brand);
  font-size: 52rpx;
  font-weight: 700;
}

.service-off {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 12rpx;
  border-radius: 0 0 0 16rpx;
  background: #ff6b00;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
}

.service-name {
  margin-top: 12rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
}

.service-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff6b00;
}

.service-price-unit {
  margin-left: 2rpx;
  font-size: 19rpx;
  color: #ff6b00;
}

.service-member {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #b98d51;
}

.service-member-muted {
  color: #a6b1c2;
}

/* ===== 报修流程 ===== */
.steps {
  display: flex;
  align-items: flex-start;
}

.step {
  width: 130rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.step-dot {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #eef3ff, #e6f8fb);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
}

.step-name {
  margin-top: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink);
}

.step-desc {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #a6b1c2;
  text-align: center;
}

.step-line {
  flex: 1;
  height: 2rpx;
  background: var(--line);
  margin-top: 26rpx;
}

/* ===== 最近工单 ===== */
.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f2f6fb;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-mark {
  width: 8rpx;
  height: 44rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.recent-main {
  flex: 1;
  min-width: 0;
}

.recent-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-loc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recent-right {
  margin-left: 20rpx;
  text-align: right;
  flex-shrink: 0;
}

.recent-time {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #a6b1c2;
}

.empty-small {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--muted);
}

/* 最近工单空态插图 */
.empty-small-img {
  display: block;
  width: 240rpx;
  height: 240rpx;
  margin: 0 auto 20rpx;
  border-radius: 24rpx;
}

/* ===== 会员权益 ===== */
.member-card {
  background: linear-gradient(135deg, #fffaf0, #fff3dc);
  border: 2rpx solid #fbeccd;
}

.member-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.member-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #8a6a33;
}

.member-badge {
  padding: 3rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #b98d51, #e6c78b);
}

.member-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #a08050;
}

.home-footer {
  padding: 30rpx 0 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #a6b1c2;
}
