<!-- 首页：品牌头部 + 广告位 + 服务保障 + 服务分类 + 快捷入口 + 报修流程 + 最近工单 + 会员权益 -->
<view class="home-page">
  <!-- 顶部渐变区 -->
  <view class="hero">
    <view class="hero-deco hero-deco-a"></view>
    <view class="hero-deco hero-deco-b"></view>

    <view class="hero-top">
      <view class="hero-user">
        <view class="hero-greeting">{{greeting}}，{{userInfo ? (userInfo.nickname || '同学') : '同学'}}</view>
        <view class="hero-sub">校园报修 · 一键提交 · 进度可查</view>
      </view>
      <!-- 课程演示：点击角色徽章切换身份 -->
      <view class="hero-role" wx:if="{{userInfo}}" bindtap="onSwitchRole" hover-class="hero-role-hover">{{roleText}} · 切换</view>
      <view class="hero-login" wx:else bindtap="goLogin">登录</view>
    </view>

    <!-- 广告轮播：大图 + 标题/副标题遮罩 + 按钮，接口失败时隐藏 -->
    <swiper class="ad-swiper" wx:if="{{ads.length > 0}}" indicator-dots circular autoplay
            interval="5000" duration="400"
            indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{ads}}" wx:key="id">
        <view class="ad-item" bindtap="goSubmit">
          <image class="ad-img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <view class="ad-mask"></view>
          <view class="ad-info">
            <view class="ad-title">{{item.title}}</view>
            <view class="ad-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</view>
            <view class="ad-btn">立即报修 ›</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <swiper class="banner" indicator-dots autoplay circular interval="4000" duration="400"
            indicator-color="rgba(255,255,255,0.45)" indicator-active-color="#ffffff">
      <swiper-item wx:for="{{banners}}" wx:key="index">
        <view class="banner-item banner-{{index}}">
          <!-- 每条 banner 使用样板图片铺满，并叠加半透明遮罩保证文字可读 -->
          <image class="banner-bg" src="{{item.img}}" mode="aspectFill" lazy-load />
          <view class="banner-mask"></view>
          <view class="banner-tag">{{item.tag}}</view>
          <view class="banner-title">{{item.title}}</view>
          <view class="banner-desc">{{item.desc}}</view>
          <view class="banner-circle banner-circle-a"></view>
          <view class="banner-circle banner-circle-b"></view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-card card">
    <view class="quick-item" wx:if="{{!isWorker}}" bindtap="goSubmit">
      <view class="quick-icon quick-icon-blue">+</view>
      <view class="quick-name">我要报修</view>
      <view class="quick-desc">提交故障信息</view>
    </view>
    <view class="quick-item" wx:if="{{!isWorker}}" bindtap="goOrders">
      <view class="quick-icon quick-icon-orange">≡</view>
      <view class="quick-name">我的工单</view>
      <view class="quick-desc">查看维修进度</view>
    </view>
    <view class="quick-item" wx:if="{{isWorker}}" bindtap="goWorkerTasks">
      <view class="quick-icon quick-icon-blue">≡</view>
      <view class="quick-name">我的任务</view>
      <view class="quick-desc">接单与完成维修</view>
    </view>
    <view class="quick-item" wx:if="{{isWorker}}" bindtap="goWorkerPool">
      <view class="quick-icon quick-icon-orange">＋</view>
      <view class="quick-name">抢单大厅</view>
      <view class="quick-desc">待接单工单</view>
    </view>
    <view class="quick-item" wx:if="{{isWorker}}" bindtap="goWorkerProfile">
      <view class="quick-icon quick-icon-green">○</view>
      <view class="quick-name">我的资料</view>
      <view class="quick-desc">简介与擅长分类</view>
    </view>
    <view class="quick-item" wx:if="{{isVip}}" bindtap="goStats">
      <view class="quick-icon quick-icon-gold">◎</view>
      <view class="quick-name">报修统计</view>
      <view class="quick-desc">会员数据概览</view>
    </view>
    <view class="quick-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <view class="quick-icon quick-icon-green">⚙</view>
      <view class="quick-name">管理后台</view>
      <view class="quick-desc">工单与用户管理</view>
    </view>
    <view class="quick-item" wx:if="{{userInfo}}" bindtap="goAiChat">
      <view class="quick-icon quick-icon-purple">✨</view>
      <view class="quick-name">AI 报修助手</view>
      <view class="quick-desc">智能诊断与建议</view>
    </view>
  </view>

  <!-- 服务保障条（静态四项） -->
  <view class="card guarantee-card">
    <view class="guarantee-item" wx:for="{{guarantees}}" wx:key="label">
      <view class="guarantee-value">{{item.value}}</view>
      <view class="guarantee-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 服务分类九宫格：图片 + 名称 + 单价 + 会员价 + 8 折角标 -->
  <view class="service-section" wx:if="{{services.length > 0}}">
    <view class="section-head service-head">
      <text class="section-title">上门维修服务</text>
      <text class="section-tip">选择服务 · 快速报修</text>
    </view>
    <view class="service-grid">
      <view class="service-card" wx:for="{{services}}" wx:key="id"
            data-id="{{item.id}}" bindtap="goService" hover-class="service-card-hover">
        <view class="service-thumb">
          <image wx:if="{{item.imageUrl}}" class="service-img" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
          <view wx:else class="service-img service-img-fallback">{{item.initial}}</view>
          <view class="service-off" wx:if="{{item.hasPrice}}">8折</view>
        </view>
        <view class="service-name">{{item.name}}</view>
        <view class="service-price-row" wx:if="{{item.hasPrice}}">
          <text class="service-price">¥{{item.priceText}}</text>
          <text class="service-price-unit">起</text>
        </view>
        <view class="service-member" wx:if="{{item.hasPrice}}">会员 ¥{{item.memberPriceText}}</view>
        <view class="service-member service-member-muted" wx:else>价格面议</view>
      </view>
    </view>
  </view>

  <!-- 报修流程 -->
  <view class="card">
    <view class="section-head">
      <text class="section-title">报修流程</text>
      <text class="section-tip">全程可查</text>
    </view>
    <view class="steps">
      <view class="step">
        <view class="step-dot">1</view>
        <view class="step-name">提交报修</view>
        <view class="step-desc">填写故障信息</view>
      </view>
      <view class="step-line"></view>
      <view class="step">
        <view class="step-dot">2</view>
        <view class="step-name">等待接单</view>
        <view class="step-desc">管理员受理</view>
      </view>
      <view class="step-line"></view>
      <view class="step">
        <view class="step-dot">3</view>
        <view class="step-name">上门维修</view>
        <view class="step-desc">处理故障</view>
      </view>
      <view class="step-line"></view>
      <view class="step">
        <view class="step-dot">4</view>
        <view class="step-name">完成工单</view>
        <view class="step-desc">查看维修备注</view>
      </view>
    </view>
  </view>

  <!-- 最近工单 -->
  <view class="card" wx:if="{{userInfo}}">
    <view class="section-head">
      <text class="section-title">{{isWorker ? '最近任务' : '最近工单'}}</text>
      <text class="section-more" wx:if="{{isWorker}}" bindtap="goWorkerTasks">全部 ›</text>
      <text class="section-more" wx:else bindtap="goOrders">全部 ›</text>
    </view>
    <view wx:for="{{recentOrders}}" wx:key="id" class="recent-item"
          data-id="{{item.id}}" bindtap="goDetail">
      <view class="recent-mark" style="background: {{item.statusColor}};"></view>
      <view class="recent-main">
        <view class="recent-title">{{item.catTitle}}</view>
        <view class="recent-loc">{{item.locationText}}</view>
      </view>
      <view class="recent-right">
        <view class="tag" style="background: {{item.statusColor}}1a; color: {{item.statusColor}};">{{item.statusText}}</view>
        <view class="recent-time">{{item.createTime}}</view>
      </view>
    </view>
    <view class="empty-small" wx:if="{{!loading && recentOrders.length === 0}}">
      <image class="empty-small-img" src="{{emptyImage}}" mode="aspectFill" lazy-load />
      <view>{{isWorker ? '暂无任务，点击「抢单大厅」接取工单' : '暂无工单，点击「我要报修」开始'}}</view>
    </view>
  </view>

  <!-- 会员权益 -->
  <view class="card member-card" wx:if="{{userInfo && !isVip}}">
    <view class="member-head">
      <text class="member-title">会员专享</text>
      <text class="member-badge">VIP</text>
    </view>
    <view class="member-desc">最多上传 5 张图片 · 自选上门时间 · 紧急工单优先处理</view>
  </view>

  <view class="home-footer">校园报修预约系统 · 让每一次报修都被看见</view>
</view>
