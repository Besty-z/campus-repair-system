/* AI 智能报修助手样式 */
page {
  height: 100%;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
}

/* ============ 顶部栏 ============ */
.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #1b47b8 0%, #2c6bf2 52%, #17bfd4 100%);
  color: #fff;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
}

.header-arrow {
  font-size: 22rpx;
  opacity: 0.85;
}

.header-new {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.key-btn {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
}
.key-btn.key-on {
  background: rgba(22, 163, 74, 0.85);
}
.key-btn.key-off {
  background: rgba(234, 88, 12, 0.85);
}

/* ============ 会话选择面板 ============ */
.session-panel {
  position: relative;
}

.session-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
}

.session-list {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 11;
  max-height: 60vh;
  background: #fff;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(18, 41, 74, 0.12);
}

.session-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  border-bottom: 2rpx solid #f2f6fb;
}

.session-item.active {
  background: var(--brand-soft);
}

.session-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-del {
  font-size: 24rpx;
  color: var(--danger);
  padding-left: 20rpx;
}

.session-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
}

/* ============ 消息列表 ============ */
.message-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.msg-row.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
}

.avatar-user {
  background: linear-gradient(135deg, #8ff0e4, #a9c8ff);
  color: #0a1728;
}

.avatar-ai {
  background: linear-gradient(135deg, #2c6bf2, #17bfd4);
}

.msg-bubble {
  max-width: 70%;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}

.bubble-user {
  background: var(--brand);
  color: #fff;
  border-top-right-radius: 6rpx;
}

.bubble-ai {
  background: #fff;
  color: var(--text);
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(18, 41, 74, 0.06);
}

.msg-content {
  white-space: pre-wrap;
}

/* 思考中动画 */
.thinking-bubble {
  display: flex;
  gap: 8rpx;
  padding: 22rpx 24rpx;
}

.thinking-bubble .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  animation: blink 1.2s infinite ease-in-out;
}

.thinking-bubble .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.thinking-bubble .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 80%, 100% { opacity: 0.3; transform: scale(0.7); }
  40% { opacity: 1; transform: scale(1); }
}

/* 空态 */
.chat-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #eef3ff, #e6f8fb);
  color: var(--brand);
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 28rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 36rpx;
}

.quick-prompts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.quick-prompt {
  padding: 14rpx 26rpx;
  background: var(--brand-soft);
  color: var(--brand);
  border-radius: 999rpx;
  font-size: 26rpx;
}

/* ============ 输入区 ============ */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 2rpx solid #eef1f7;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.chat-input {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  padding: 18rpx 24rpx;
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  line-height: 1.5;
}

.send-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
}

.send-btn::after {
  border: none;
}

.send-btn.disabled {
  background: #c3d4f7;
  color: #fff;
}

/* ============ API Key 设置弹窗 ============ */
.key-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.key-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}

.key-modal-box {
  position: relative;
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}

.key-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  margin-bottom: 18rpx;
}

.key-modal-tip {
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.key-modal-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f6f8fd;
  border: 2rpx solid #edf1f9;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
}

.key-modal-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  margin-top: 32rpx;
}

.key-btn-clear,
.key-btn-cancel,
.key-btn-save {
  font-size: 28rpx;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  text-align: center;
}

.key-btn-clear {
  background: #fef0e6;
  color: #ea580c;
}

.key-btn-cancel {
  background: #f2f6fb;
  color: var(--muted);
}

.key-btn-save {
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #fff;
  font-weight: 600;
}
