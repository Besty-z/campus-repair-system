/* 维修工「抢单大厅」样式 */

.pool-page {
  padding-bottom: 30rpx;
}

.pool-tip {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 8rpx;
  padding: 18rpx 24rpx;
  border-radius: 20rpx;
  background: rgba(239, 75, 75, 0.07);
  font-size: 23rpx;
  color: var(--danger);
}

.tip-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: var(--danger);
  box-shadow: 0 0 0 6rpx rgba(239, 75, 75, 0.14);
  flex-shrink: 0;
}

/* 工单卡片 */
.pool-card {
  position: relative;
  margin: 16rpx 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
}

.pool-urgent {
  background: linear-gradient(180deg, #fff8f8 0%, #ffffff 42%);
  box-shadow: 0 16rpx 44rpx rgba(239, 75, 75, 0.12);
}

.pool-urgent::before {
  content: '';
  position: absolute;
  left: 0;
  top: 34rpx;
  bottom: 34rpx;
  width: 8rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: var(--danger);
}

.pool-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f2f6fb;
}

.pool-mark {
  width: 8rpx;
  height: 44rpx;
  margin-right: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #2c6bf2, #17bfd4);
  flex-shrink: 0;
}

.pool-title-wrap {
  flex: 1;
  min-width: 0;
}

.pool-title {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.cat-chip {
  margin-right: 10rpx;
  margin-bottom: 4rpx;
  color: var(--brand);
  background: var(--brand-soft);
}

.pool-no {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a6b1c2;
}

.head-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.urgent-tag {
  padding: 3rpx 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--danger);
  background: rgba(239, 75, 75, 0.1);
  border-radius: 999rpx;
}

.pool-row {
  display: flex;
  margin-top: 14rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.row-label {
  width: 130rpx;
  flex-shrink: 0;
  color: #98a5b8;
}

.row-value {
  flex: 1;
  color: var(--text);
  word-break: break-all;
}

.pool-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f2f6fb;
}

.pool-time {
  font-size: 22rpx;
  color: #a6b1c2;
}

.grab-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 40rpx;
  margin: 0;
  background: linear-gradient(135deg, #2c6bf2 0%, #17bfd4 100%);
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(44, 107, 242, 0.22);
}

.grab-btn::after {
  border: none;
}
